# Server
PORT=5000
NODE_ENV=development

# Comma-separated allowed frontend URLs (required in production for split hosting)
# Examples:
#   Local:           http://localhost:5173
#   Render full-stack: https://your-app.onrender.com
#   Vercel + Render: https://your-site.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Admin login — CHANGE THESE before going live
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=PickAStrongPassword123!
JWT_SECRET=paste-a-long-random-string-here-at-least-32-chars

# Set true once to reset admin password from env, then set back to false
RESEED_ADMIN=false

# Optional: email you when someone uses Contact (Gmail App Password recommended)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=noreply@example.com
